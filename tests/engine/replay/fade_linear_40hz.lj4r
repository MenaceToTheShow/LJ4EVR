LJ4 replay 1
# fade_linear_40hz: one 0 -> 255 and one 255 -> 0 channel, fade 2550 ms at 40 Hz (rig M1/M2; 11 F3 nearest
# rounding, ties away from `from`). The down-fade starts from DefaultOut: from[] is the live output (11 F3).
tick_us=25000
patch 1 profile=19 link=1 addr=1
patch 2 profile=19 link=1 addr=2
default 1:2=255
seq 1 name="fade" scene st=10000 ft=2550 ch 1:1=255:F 1:2=0:F
cue 1 slot=1 seq=1
at 0 load_cue 1
expect 0 1:1=0 1:2=255 layer=1
expect 1 1:1=3 1:2=252 layer=1
expect 2 1:1=5 1:2=250 layer=1
expect 25 1:1=63 1:2=192 layer=1
expect 51 1:1=128 1:2=127 layer=1
expect_merged 51 1:1=128 1:2=127   # merged == out: no post stage touches a LEVEL channel at GM 255 (LORD_ENGINE-21)
expect 76 1:1=190 1:2=65 layer=1
expect 101 1:1=253 1:2=2 layer=1
expect 102 1:1=255 1:2=0 layer=1
expect 120 1:1=255 1:2=0 layer=1
