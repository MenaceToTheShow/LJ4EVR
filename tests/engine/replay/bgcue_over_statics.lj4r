LJ4 replay 1
# bgcue_over_statics (03 s7, s8; design 3.4 rank 4 < rank 5; LJ_BG_SLOT5_OVER_1, LJ_BG_FORWARD_ONLY): a static programs
# 1:1=200; bg cue 1 slot 1 programs 1:1=20 and slot 5 1:1=250; transparent bg cue 2 has only slot 3 (1:2=77, noloop);
# cue 1 latches bg cue 1 and runs 1:2=30 in its slot 1.
# NOTE 03 s8 / 11 C5: statics have "higher priority than the current cue, but lower priority than the current background
#      cue"; 03 s7 / 11 C3: the BG cue is above the cue and the current sequence (design 3.4: rank 5 over rank 4).
# NOTE 03 s7 "the higher the number of the slot in the background cue the higher the priority" (LJ_BG_SLOT5_OVER_1):
#      tick 1 slot 5 (250) over slot 1 (20); `bg_on bg5 0` (BGCue Toggle slot 5, LJ_CMD_BG_ON) uncovers slot 1.
# NOTE 03 s7 transparent BG cue: "empty slots do not overwrite" (tick 4 keeps slots 1 and 5 of bg cue 1).
# NOTE design 2.3 rule 3: a cue's latched bg_cue the UI could not pin arrives as pending_bg (tick 6, `load_cue 1 nobg`);
#      `at 7 ack_bg` is the UI-side ack (lj_app_service_pending -> lj_app_load_bgcue -> LOAD_BG with bgseq[] pinned).
# NOTE BGCue All Slots Off / On = `bg_on all 0|1` (ticks 8, 9).
# NOTE W1 fails this file at tick 1 (expect_view bg expected 1 got 0: bg_number is a W2 view field) and tick 2
#      (BG_ON: 1:1 expected 20 got 250).
tick_us=25000
patch 1 profile=19 link=1 addr=1
profile 1 class1=intensity use_gm=1
patch 2 profile=19 link=1 addr=2
profile 2 class1=intensity use_gm=1
seq 1 name="bg1" scene st=60000 ft=50 ch 1:1=20:S
seq 5 name="bg5" scene st=60000 ft=50 ch 1:1=250:S
seq 3 name="bg3" scene st=60000 ft=50 ch 1:2=77:S
seq 7 name="cue" scene st=60000 ft=50 ch 1:2=30:S
bg 1 name="BG"
bgslot 1 seq=1
bgslot 5 seq=5
bg 2 name="BGT" transparent=1
bgslot 3 seq=3 mode=noloop
cue 1 bgcue=1
slot 1 seq=7
static 1.1 name="S" act=toggle rep=add ft=50 level=100
ch 1:1=200:S
at 0 static_act 1.1
expect 0 1:1=200 layer=4
at 1 load_bg 1
expect 1 1:1=250 layer=5
expect_view 1 bg_any=1 bg=1 statics_any=1
at 2 bg_on bg5 0
expect 2 1:1=20 layer=5
at 3 bg_on bg5 1
expect 3 1:1=250 layer=5
at 4 load_bg 2
expect 4 1:1=250 1:2=77 layer=5
expect_view 4 bg=2
at 5 load_bg 0
expect 5 1:1=200 layer=4
expect 5 1:2=0 layer=0
expect_view 5 bg_any=0 bg=0
# the latched bg cue of cue 1, through pending_bg
at 6 load_cue 1 nobg
expect 6 1:1=200 layer=4
expect 6 1:2=30 layer=1
expect_pending 6 bg 1
at 7 ack_bg
expect 7 1:1=250 layer=5
expect 7 1:2=30 layer=1
expect_view 7 bg=1 cue=1
at 8 bg_on all 0
expect 8 1:1=200 layer=4
expect_view 8 bg_any=0
at 9 bg_on all 1
expect 9 1:1=250 layer=5
