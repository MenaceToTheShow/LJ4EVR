LJ4 replay 1
# drift_600s_two_slots_wire (design 10 W2 acceptance 3, 11 E10, ME-24; rig M23): the 10-minute two-slot run.
# Slot 1 flips every 4.00 s (2 scenes), slot 2 steps every 0.333 s (3 scenes, not a tick multiple). CTest runs this file
# headless (row replay_wire_drift); the acceptance integrator runs the same file through
# `lj4evr_tests replay tests/engine/replay/wire/drift_600s_two_slots_wire.lj4r` beside a live sACN capture of the same
# show and compares the capture's boundary ticks with the expect rows below (per-second packet counts never above ~40,
# ME-24). It lives outside the replay_all glob so replay_dump stays the W1-sized stream plus the nine W2 scenarios.
# NOTE 11 E10 "compensate for small, accumulating timing errors ... which would cause the sequences and cues to 'slide'":
#      boundaries sit on an absolute timeline, boundary n of slot 2 on tick ceil(333 n / 25). At t = 600 s the cumulative
#      drift is 0: slot 1's boundary 150 (600000 ms) lands on tick 24000 exactly; slot 2's boundary 1801 (599733 ms) on
#      tick 23990 and boundary 1802 (600066 ms) on tick 24003, jitter <= 1 tick. A relative re-arm (due = now + 333 ms,
#      counted from the tick that saw the boundary) would make every 333 ms scene 14 ticks long and put boundary 1801 on tick 25214.
tick_us=25000
patch 1 profile=70 link=1 addr=1
seq 1 name="flip"
scene st=4000 ft=50 ch 1:1=0:S
scene st=4000 ft=50 ch 1:1=255:S
seq 2 name="third"
scene st=333 ft=50 ch 1:2=10:S
scene st=333 ft=50 ch 1:2=20:S
scene st=333 ft=50 ch 1:2=30:S
cue 1
slot 1 seq=1
slot 2 seq=2
at 0 load_cue 1
expect 0 1:1=0 1:2=10
expect 13 1:2=10
expect 14 1:2=20     # slot 2 boundary 1 at 333 ms
expect 159 1:1=0
expect 160 1:1=255   # slot 1 boundary 1 at 4000 ms
expect_status 160 slot1 running scene=2:2
run 23900
expect 23989 1:2=10  # boundary 1800 at 599400 ms was tick 23976
expect 23990 1:2=20  # boundary 1801 at 599733 ms
expect_status 23990 slot2 running scene=2:3
expect 23999 1:1=255
expect 24000 1:1=0   # slot 1 boundary 150 at 600000 ms: zero cumulative drift
expect_status 24000 slot1 running scene=1:2
expect 24002 1:2=20
expect 24003 1:2=30  # boundary 1802 at 600066 ms
expect_status 24003 slot2 running scene=3:3
