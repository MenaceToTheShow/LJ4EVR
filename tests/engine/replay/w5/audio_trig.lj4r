LJ4 replay 1
# audio_trig (W5-AUD-3, track audio, 2026-10-23): analyzer trigs reach every runner in audio trig mode through the one
# command Emulate Audio Trig posts (LJ_CMD_TRIG LJ_RUN_ALL / LJ_TRIG_AUDIO_EVENT). Cue 1 slot 1 runs 4 scenes on 1:1 with
# Audio-Trigs / Trig 2 (05 s9.1), slot 2 is auto (60 s scenes, never moves here), BG cue 1 slot 1 is mode=audio (one
# scene per trig). Then the Loop Options dialog raises slot 1 to 3 trigs per scene. Outside the replay_all glob (W5-X-REPLAY).
tick_us=25000
patch 1 profile=19 link=1 addr=1
profile 1 class1=intensity use_gm=1
patch 2 profile=19 link=1 addr=2
profile 2 class1=intensity use_gm=1
patch 3 profile=19 link=1 addr=3
profile 3 class1=intensity use_gm=1
seq 1 name="audio slot"
scene st=60000 ft=0 ch 1:1=10:S
scene st=60000 ft=0 ch 1:1=20:S
scene st=60000 ft=0 ch 1:1=30:S
scene st=60000 ft=0 ch 1:1=40:S
seq 2 name="auto slot"
scene st=60000 ft=0 ch 1:2=50:S
scene st=60000 ft=0 ch 1:2=60:S
seq 3 name="bg audio"
scene st=60000 ft=0 ch 1:3=70:S
scene st=60000 ft=0 ch 1:3=80:S
scene st=60000 ft=0 ch 1:3=90:S
bg 1 name="audio bg"
bgslot 1 seq=3 mode=audio
cue 1
slot 1 seq=1 trig=audio atpt=2
slot 2 seq=2 trig=auto
at 0 load_cue 1
at 0 load_bg 1
expect 1 1:1=10 1:2=50 1:3=70
at 2 audio_trig
expect 2 1:1=10 1:2=50 1:3=80          # trig 1: the BG slot moves, the slot waits for its second
at 3 audio_trig
expect 3 1:1=20 1:2=50 1:3=90          # trig 2: the slot advances one scene
at 4 audio_trig
at 5 audio_trig
expect 5 1:1=30 1:2=50                 # every second trig
at 6 loop slot1 atpt=3
at 7 audio_trig
at 8 audio_trig
expect 8 1:1=30                        # 3 per scene now: two are not enough
at 9 audio_trig
expect 9 1:1=40 1:2=50
