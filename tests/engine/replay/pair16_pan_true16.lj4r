LJ4 replay 1
# pair16_pan_true16 (ME-22, 11 F24, rig M11): MAC 500 Mode 2/4 pan 11/12 and tilt 13/14 are one 16-bit value through
# the fade; the exact value is asserted every tick, the LSB is non-zero on every intermediate tick
# (1500 k mod 256 != 0 for k < 64) and the pair is monotonic. Pan 0 -> 60000, tilt 0 -> 32768, 1000 ms = 40 ticks.
tick_us=25000
patch 1 profile=12 link=1 addr=1   # Martin / MAC 500 / Mode 2/4, pt16 pan_ofs 10 tilt_ofs 12
default 1:11=0 1:12=0 1:13=0 1:14=0
seq 1 name="pan" scene st=5000 ft=1000 ch 1:11=234:F 1:12=96:F 1:13=128:F 1:14=0:F
cue 1 slot=1 seq=1
at 0 load_cue 1
expect_pair 0 1:11=0 1:13=0
