LJ4 replay 1
# gm_examples_1_to_6: the six worked examples of 11 s5.2 (d) (CHM L10393-10437), each programmed value its own
# one-channel fixture with the recipe's Intensity tab settings as a `profile` override (class intensity, Min/Max,
# Enable GM, Invert range, Limit GM). GM 50 % = level 127 of LJ_GM_DOMAIN 255 (the fader's 50 % mark), 75 % = 191.
# S3 (masters, one factor per mode: LORD_ENGINE-18, nearest rounding) runs before S2 (inversion): Example 3 gives
# 0/128/255 and Example 6 gives 100/150/200 at GM 100/50/0 %, strobe 50 and 230 unchanged (ME-1, rig M21).
# Fixture 17 is ME-25 (S3): a SWITCH channel stays unscaled until a master is 0. Fixture 18 is in sub-master 1 and
# walks the four sub-master modes (11 G2).
tick_us=25000
submaster 1 name="Sub1" mode=lotp
patch 1 profile=19 link=1 addr=1
profile 1 class1=intensity use_gm=1 imin=0 imax=255   # Ex1 v=255
patch 2 profile=19 link=1 addr=2
profile 2 class1=intensity use_gm=1 imin=0 imax=255   # Ex1 v=100
patch 3 profile=19 link=1 addr=3
profile 3 class1=intensity use_gm=1 imin=0 imax=255   # Ex1 v=0
patch 4 profile=19 link=1 addr=4
profile 4 class1=intensity use_gm=1 imin=0 imax=127   # Ex2 v=127
patch 5 profile=19 link=1 addr=5
profile 5 class1=intensity use_gm=1 imin=0 imax=127   # Ex2 v=64
patch 6 profile=19 link=1 addr=6
profile 6 class1=intensity use_gm=1 imin=0 imax=127   # Ex2 v=200
patch 7 profile=19 link=1 addr=7
profile 7 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=0 imax=255   # Ex3 v=255
patch 8 profile=19 link=1 addr=8
profile 8 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=0 imax=255   # Ex3 v=0
patch 9 profile=19 link=1 addr=9
profile 9 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=0 imax=127 limit_gm=1   # Ex4 v=127
patch 10 profile=19 link=1 addr=10
profile 10 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=0 imax=127 limit_gm=1   # Ex4 v=63
patch 11 profile=19 link=1 addr=11
profile 11 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=0 imax=127 limit_gm=1   # Ex4 v=200
patch 12 profile=19 link=1 addr=12
profile 12 class1=intensity use_gm=1 imin=0 imax=127 limit_gm=1   # Ex5 v=100
patch 13 profile=19 link=1 addr=13
profile 13 class1=intensity use_gm=1 imin=0 imax=127 limit_gm=1   # Ex5 v=200
patch 14 profile=19 link=1 addr=14
profile 14 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=100 imax=200 limit_gm=1   # Ex6 v=200
patch 15 profile=19 link=1 addr=15
profile 15 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=100 imax=200 limit_gm=1   # Ex6 v=50
patch 16 profile=19 link=1 addr=16
profile 16 class1=intensity use_gm=1 invert_int=1 invert_range=1 imin=100 imax=200 limit_gm=1   # Ex6 v=230
patch 17 profile=19 link=1 addr=17
profile 17 class1=switch use_gm=0   # SW v=255
patch 18 profile=19 link=1 addr=18 sub=1
profile 18 class1=intensity use_gm=1 imin=0 imax=255   # Sub v=255
seq 1 name="gm" scene st=60000 ft=50 ch 1:1=255:S 1:2=100:S 1:3=0:S 1:4=127:S 1:5=64:S 1:6=200:S 1:7=255:S 1:8=0:S 1:9=127:S 1:10=63:S 1:11=200:S 1:12=100:S 1:13=200:S 1:14=200:S 1:15=50:S 1:16=230:S 1:17=255:S 1:18=255:S
cue 1 slot=1 seq=1
# tick 0: gm 255, sub1 255 (lotp)
# tick 1: gm 127, sub1 255 (lotp)
# tick 2: gm 0, sub1 255 (lotp)
# tick 3: gm 191, sub1 255 (lotp)
# tick 4: gm 255, sub1 255 (lotp)
# tick 5: gm 255, sub1 64 (lotp)
# tick 6: gm 255, sub1 64 (htp)
# tick 7: gm 255, sub1 64 (prop)
# tick 8: gm 255, sub1 64 (none)
# tick 9: gm 127, sub1 64 (none)
# tick 10: gm 127, sub1 64 (prop)
# tick 11: gm 0, sub1 64 (prop)
at 0 load_cue 1
expect 0 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 0 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 0 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=255
expect_view 0 gm=255
at 1 master gm 127
expect 1 1:1=127 1:2=50 1:3=0 1:4=63 1:5=32 1:6=100
expect 1 1:7=128 1:8=255 1:9=64 1:10=96 1:11=200 1:12=50
expect 1 1:13=200 1:14=150 1:15=50 1:16=230 1:17=255 1:18=127
expect_view 1 gm=127
at 2 master gm 0
expect 2 1:1=0 1:2=0 1:3=0 1:4=0 1:5=0 1:6=0
expect 2 1:7=255 1:8=255 1:9=127 1:10=127 1:11=200 1:12=0
expect 2 1:13=200 1:14=200 1:15=50 1:16=230 1:17=0 1:18=0
expect_view 2 gm=0
at 3 master gm 191
expect 3 1:1=191 1:2=75 1:3=0 1:4=95 1:5=48 1:6=150
expect 3 1:7=64 1:8=255 1:9=32 1:10=80 1:11=200 1:12=75
expect 3 1:13=200 1:14=125 1:15=50 1:16=230 1:17=255 1:18=191
expect_view 3 gm=191
at 4 master gm 255
expect 4 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 4 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 4 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=255
expect_view 4 gm=255
at 5 master sub1 64 lotp
expect 5 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 5 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 5 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=64
expect_view 5 gm=255
at 6 master sub1 64 htp
expect 6 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 6 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 6 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=255
expect_view 6 gm=255
at 7 master sub1 64 prop
expect 7 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 7 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 7 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=64
expect_view 7 gm=255
at 8 master sub1 64 none
expect 8 1:1=255 1:2=100 1:3=0 1:4=127 1:5=64 1:6=200
expect 8 1:7=0 1:8=255 1:9=0 1:10=64 1:11=200 1:12=100
expect 8 1:13=200 1:14=100 1:15=50 1:16=230 1:17=255 1:18=64
expect_view 8 gm=255
at 9 master gm 127
expect 9 1:1=127 1:2=50 1:3=0 1:4=63 1:5=32 1:6=100
expect 9 1:7=128 1:8=255 1:9=64 1:10=96 1:11=200 1:12=50
expect 9 1:13=200 1:14=150 1:15=50 1:16=230 1:17=255 1:18=64
expect_view 9 gm=127
at 10 master sub1 64 prop
expect 10 1:1=127 1:2=50 1:3=0 1:4=63 1:5=32 1:6=100
expect 10 1:7=128 1:8=255 1:9=64 1:10=96 1:11=200 1:12=50
expect 10 1:13=200 1:14=150 1:15=50 1:16=230 1:17=255 1:18=32
expect_view 10 gm=127
at 11 master gm 0
expect 11 1:1=0 1:2=0 1:3=0 1:4=0 1:5=0 1:6=0
expect 11 1:7=255 1:8=255 1:9=127 1:10=127 1:11=200 1:12=0
expect 11 1:13=200 1:14=200 1:15=50 1:16=230 1:17=0 1:18=0
expect_view 11 gm=0
