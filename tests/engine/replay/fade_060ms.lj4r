LJ4 replay 1
# fade_060ms: 0.06 s is the smallest fade that is not a snap (11 F4, F28): 0 -> 255 over 60 ms = 2 intermediate ticks.
# Slot 3 is LORD_ENGINE-11 / rig M3(d): a programmed 500 ms fade at time 10 % is 50 ms after scaling, so it snaps
# (LJ_SNAP_TEST_AFTER_SCALE 1).
tick_us=25000
patch 1 profile=19 link=1 addr=1
patch 3 profile=19 link=1 addr=3
seq 1 name="f60" scene st=1000 ft=60 ch 1:1=255:F
seq 3 name="scaled" scene st=1000 ft=500 ch 1:3=255:F
cue 1
slot 1 seq=1
slot 3 seq=3 time=10
at 0 load_cue 1
expect 0 1:1=0
expect 0 1:3=255   # snap after scale: fade 500 ms x 10 % = 50 ms <= LJ_SNAP_MS
expect 1 1:1=106
expect 1 1:3=255
expect 2 1:1=213
expect 3 1:1=255
expect 10 1:1=255
