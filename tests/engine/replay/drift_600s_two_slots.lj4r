LJ4 replay 1
# drift_600s_two_slots (11 E10, rig M23): 24000 ticks = 600 s; scene boundaries on an absolute timeline, so slot 2's
# 333 ms scene time (not a tick multiple) lands on tick ceil(333 n / 25) for every n with zero cumulative drift and
# jitter <= 1 tick: boundary 1801 (599733 ms) is tick 23990, not 23989. Slot 1 flips every 1000 ms = 40 ticks.
tick_us=25000
