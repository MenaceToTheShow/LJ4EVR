LJ4 replay 1
# disabled_offset_silent (LORD_FIXTURES-11): a disabled control channel is unpatched for every layer, so its output is
# DefaultOut even when a scene programs it; the profile's default DMX values are copied into DefaultOut by Fixture
# Configuration on save (the harness's `patch`/`profile` lines), a `default` line after them overrides.
tick_us=25000
patch 1 profile=56 link=1 addr=1
profile 1 disabled3=1 ddmx3=66 ddmx1=5 ddmx4=7
default 1:2=9
seq 1 name="dis" scene st=60000 ft=50 ch 1:1=200:S 1:2=200:S 1:3=200:S
cue 1 slot=1 seq=1
at 0 load_cue 1
expect 0 1:1=200 1:2=200 layer=1
expect 0 1:3=66 1:4=7 layer=0
expect_merged 0 1:3=66 1:4=7
