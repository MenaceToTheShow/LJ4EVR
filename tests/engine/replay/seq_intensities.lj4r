LJ4 replay 1
# seq_intensities: Martin's 12-cell table (03 s5.9, 11 F18, LORD_ENGINE-17). Fixtures 1-4 are intensity channels; slots
# 1-3 carry Seq #1-#3 with S.I. 30/40/50 % = 77/102/128 of 255; programmed 100/50/30/10 % = 255/128/77/26.
# Default: the highest slot with an active intensity wins, scaled by its S.I.; HTP: the highest programmed x S.I.
# wins; LoTP: the lowest. Output = the winner's value x S.I., nearest rounding ((v * si + 127) / 255).
# NOTE 03 s5.9 table rows Default / HTP / LoTP = ticks 0 / 1 / 2 (Default again at 3); fixtures 1-4 = the table's columns.
# NOTE 03 s5.9 "acting only on active intensity values" (design 3.4 rank 1, intensity-class channels only): fixture 5 is
#      a colour channel (class1=color), so slot 3 wins it unscaled in every mode.
# NOTE 03 s5.9 "The comparison uses programmed scene values, not the momentary faded output" (LORD_ENGINE-17,
#      LJ_SEQINT_ON_PROGRAMMED): fixture 6 fades 0 -> 255 over 10 s in slot 1 (key 255 x 77 = 77) against slot 2's
#      snapped 128 (key 128 x 102 = 51). HTP picks slot 1 by its programmed value and outputs its faded value x S.I.
#      (1 x 77 -> 0 at tick 1); a faded-value comparison would output 51. LoTP and Default pick slot 2 (51).
# NOTE 03 s5.9 "Unassigned slots count as 100%" (LJ_SEQINT_UNASSIGNED 255): tick 4 puts slot 2 back to 255 under HTP.
# NOTE W2: lj_merge.c calls lj_seq_intensity_rule (lj_runner.h) instead of its own copy; every row here must hold across
#      that switch. The W1 engine passes this file too (the table was a W1 bonus row).
tick_us=25000
patch 1 profile=19 link=1 addr=1
profile 1 class1=intensity use_gm=1
patch 2 profile=19 link=1 addr=2
profile 2 class1=intensity use_gm=1
patch 3 profile=19 link=1 addr=3
profile 3 class1=intensity use_gm=1
patch 4 profile=19 link=1 addr=4
profile 4 class1=intensity use_gm=1
patch 5 profile=19 link=1 addr=5
profile 5 class1=color
patch 6 profile=19 link=1 addr=6
profile 6 class1=intensity use_gm=1
seq 1 name="Seq1" scene st=60000 ft=10000 ch 1:2=255:S 1:3=128:S 1:4=26:S 1:5=100:S 1:6=255:F
seq 2 name="Seq2" scene st=60000 ft=50 ch 1:1=255:S 1:6=128:S
seq 3 name="Seq3" scene st=60000 ft=50 ch 1:1=77:S 1:2=128:S 1:4=128:S 1:5=200:S
cue 1
slot 1 seq=1
slot 2 seq=2
slot 3 seq=3
at 0 load_cue 1
at 0 seq_int slot1 77
at 0 seq_int slot2 102
at 0 seq_int slot3 128
expect 0 1:1=39 1:2=64 1:3=39 1:4=64   # default
expect 0 1:5=200 1:6=51 layer=1
at 1 seq_int mode htp
expect 1 1:1=102 1:2=77 1:3=39 1:4=64   # htp
expect 1 1:5=200 1:6=0
at 2 seq_int mode lotp
expect 2 1:1=39 1:2=64 1:3=39 1:4=8   # lotp
expect 2 1:5=200 1:6=51
at 3 seq_int mode default
expect 3 1:1=39 1:2=64 1:3=39 1:4=64   # default
expect 3 1:5=200 1:6=51
at 4 seq_int mode htp
at 4 seq_int slot2 255
expect 4 1:1=255 1:2=77 1:3=39 1:4=64 1:5=200   # htp, slot 2 unassigned (100 %): fixture 1 = 255
expect_merged 4 1:1=255 1:5=200
