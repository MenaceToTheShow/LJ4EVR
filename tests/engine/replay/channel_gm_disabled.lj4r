LJ4 replay 1
# channel_gm_disabled (ME-32, fidelity "Generic DMX Dimmer, Grand Master"): Channel Configuration's "Disable Grand
# Master Control" on one offset of a generic dimmer leaves that channel unscaled in S3 while its neighbours follow the
# GM ("By default, all generic DMX channels are affected by the Grand Master", CHM genericdmxprofiles); chgm= is the
# Config.dat list (offsets 1..32). GM 50 % (127) halves 1:1 and 1:3, 1:2 stays 255; GM 0 leaves 1:2 at 255 too.
tick_us=25000
patch 1 profile=56 link=1 addr=1 chgm=2
seq 1 name="full" scene st=60000 ft=50 ch 1:1=255:S 1:2=255:S 1:3=255:S
cue 1 slot=1 seq=1
at 0 load_cue 1
expect 0 1:1=255 1:2=255 1:3=255
at 1 master gm 127
expect 1 1:1=127 1:2=255 1:3=127
at 2 master gm 0
expect 2 1:1=0 1:2=255 1:3=0
