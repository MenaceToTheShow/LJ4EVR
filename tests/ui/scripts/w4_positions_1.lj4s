open rgb_palette
wait 200
move rgb_palette 180 1880
wait 200
close rgb_palette
open select_cuelist_modal
wait 200
move select_cuelist_modal 220 1900
wait 200
close select_cuelist_modal
open debug
wait 200
move debug 260 1920
wait 200
close debug
open statics_debug
wait 200
move statics_debug 300 1940
wait 200
close statics_debug
open msg_debug
wait 200
move msg_debug 340 1960
wait 200
close msg_debug
click main.tb_fixture_13
click main.icon1
rclick main.icon1
click main.PI_Info
wait 200
move fixture_info 380 1980
wait 200
close fixture_info
click main.tb_fixture_13
click main.icon3
rclick main.icon3
click main.PI_Customize
wait 200
move rgbpack_defs 420 2000
wait 200
close rgbpack_defs
quit
