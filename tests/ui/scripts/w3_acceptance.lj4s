# w3_acceptance.lj4s - the W3 "Show control" walkthrough of design 10 W3 as a --script (docs/ui-script.md,
# W3 verbs). Desktop-app track first draft, 2026-10-22. Run from the repo root on a fresh Default library
# (delete <userdir>User\Default, <userdir>forms.ini and <userdir>Default.lj4b) so the records get numbers
# 0001 / 0002 and the shots land in docs/screenshots/w3/:
#   build-ninja-msvc\lj4evr.exe --script tests\ui\scripts\w3_acceptance.lj4s
# Fixtures: MAC 500 Mode 2/4 at 1:001 (fixture 1), Generic DMX Dimmer at 1:017 (fixture 2, as W2), four more
# MAC 500 at 1:033 / 1:049 / 1:065 / 1:081 (fixtures 3-6) for Fan Out.
# Widget names: DFM object names (ui/forms/lj_forms_gen.c). The RECONCILE lines of the first draft were checked
# against the landed windows by W3 integrator 2 (docs/w3-integration.md, Acceptance). Every line parses at load
# (tests/app/test_uiscript_w3.c loads this file in CI). Release and Debug runs: rc 0.
# Generic macro frame values at given ticks are asserted at synthetic time by replay genmacro_sine_amp186 (design 3.7);
# a live run cannot name the tick the macro started on, so this walkthrough asserts the editor's Min/Max readout
# and the view fields, and freezes the movement macro (speed 0) to assert positions at two ticks.

log "W3 acceptance: six fixtures (MAC 500 x5, a dimmer)"
open fixture_config
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbMartin
key Right
key Down 60
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "1"
key Enter
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbGeneric
key Right
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "17"
key Enter
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbMartin
key Right
key Down 60
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "33"
key Enter
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbMartin
key Right
key Down 60
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "49"
key Enter
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbMartin
key Right
key Down 60
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "65"
key Enter
click TLinkConfigForm3.tvAvailable 100 8
click TLinkConfigForm3.sbMartin
key Right
key Down 60
key Right
key Right
click TLinkConfigForm3.bAdd
click TLinkConfigForm3.eAdr
type "81"
key Enter
assert_text TLinkConfigForm3.LFixtures "6 Fixtures configured"
click TLinkConfigForm3.bSave
close fixture_config
wait 300
close cue_form
close seq_form
move TUnassignedForm 1800 1600                  # the stay-on-top list opens centred over the desktop; drops 3-6 landed on it
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 -300 -120
wait 300
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 -230 -120
wait 300
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 -160 -120
wait 300
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 -90 -120
wait 300
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 -20 -120
wait 300
drag TUnassignedForm.LV_Unassigned main.desktop 40 26 50 -120
wait 300
assert_text main.icon1 "(1) MAC500"
assert_text main.icon2 "(2) DMX1"
assert_text main.icon6 "(6) MAC500"

# ---- two cues: 0001 "odd" and 0002 "even" (empty: the list only has to latch them) ----
log "W3 acceptance: cues 0001 / 0002"
open cue_form
click TCurrentCue.sbSaveCue
wait 300
click TSaveCueForm.ECueName
type "odd"
click TSaveCueForm.BSaveNew
wait 300
assert_caption TCurrentCue "CUE [0001 odd]"

# ---- acceptance 1: a 20-line cue list built through the Cuelist window ----
# Line k latches cue 0001 (k odd) or 0002 (k even); lines 2-20 Wait Elapsed 1.00 s; lines 10 and 15 Manual,
# whose wait is ignored (LJ_CL_MANUAL_IGNORES_WAITS [03 s6.1]).
log "W3 acceptance: 20-line cue list"
open cuelist_form
click TCuelist2Form.sbNew
rclick TCuelist2Form.sbAdd                       # right-click Add = 10 lines [03 s6.2]
rclick TCuelist2Form.sbAdd
cl_assert_line 20 plain
cl_goto 1
click TCuelist2Form.Pop_SetCurrentCue          # ListPop "Set Current Cue": cue 0001
cl_goto 3
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 5
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 7
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 9
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 11
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 13
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 15
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 17
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 19
click TCuelist2Form.Pop_SetCurrentCue
click TCurrentCue.sbNewCue
click TCurrentCue.sbSaveCue
wait 300
click TSaveCueForm.ECueName
type "even"
click TSaveCueForm.BSaveNew
wait 300
assert_caption TCurrentCue "CUE [0002 even]"
cl_goto 2
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 4
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 6
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 8
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 10
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 12
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 14
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 16
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 18
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 20
click TCuelist2Form.Pop_SetCurrentCue
cl_goto 2
click TCuelist2Form.popWaitTimeOut             # ListPop > PC Time Commands > Wait Elapsed (aWaitElapsed)
click TCuelist2Form.eElapsedSec               # the TclEditPanels edit inside pEdit
key End
key BS 2
type "1"
key Enter
cl_goto 3
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 4
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 5
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 6
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 7
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 8
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 9
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 10
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 11
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 12
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 13
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 14
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 15
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 16
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 17
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 18
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 19
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 20
click TCuelist2Form.popWaitTimeOut
click TCuelist2Form.eElapsedSec
key End
key BS 2
type "1"
key Enter
cl_goto 10
click TCuelist2Form.AdvanceManual1               # ListPop > Set Advance > Manual (aAdvanceManual)
cl_goto 15
click TCuelist2Form.AdvanceManual1               # ListPop > Set Advance > Manual (aAdvanceManual)
click TCuelist2Form.M_UseColor                   # Preferences > Use Color Codes (cuelist1.gif colours)
shot docs/screenshots/w3/cuelist-20-lines.png
click TCuelist2Form.sbSave
wait 300
click TSaveCuelist2Form.eCuelistName
type "twenty"
click TSaveCuelist2Form.bSaveNew
wait 300
assert_file CueLists/00000001.Cl2 exists

# run against PC elapsed: Go on an idle list = Run from top [03 s6.5]; the asserts sit half a second after each latch
log "W3 acceptance: run against PC elapsed"
click TCuelist2Form.sbPCElapsed
cl_execute
wait 500
assert_view cue_number 1                         # line 1 at 0 s
wait 1000
assert_view cue_number 2                         # line 2 at 1 s
wait 1000
assert_view cue_number 1                         # line 3 at 2 s
wait 6000
assert_view cue_number 1                         # line 9 at 8 s; line 10 is Manual
cl_assert_line 10 next
cl_assert_line 9 done
wait 2000
assert_view cue_number 1                         # 10.5 s: the manual line ignored its 1 s wait
cl_execute
wait 300
assert_view cue_number 2                         # line 10 on Go !
wait 4500
assert_view cue_number 2                         # line 14 at Go + 4 s; line 15 is Manual
cl_assert_line 15 next
cl_execute
wait 300
assert_view cue_number 1                         # line 15 on Go !
wait 5000
assert_view cue_number 2                         # line 20 at Go + 5 s, the list ends
cl_assert_line 20 done
shot docs/screenshots/w3/cuelist-run.png

# ---- acceptance 2: a .Cl2 with an MP Play line loads with that line red and runs the rest ----
log "W3 acceptance: MP Play line"
cl_load tests/ui/scripts/w3_mp_play.Cl2
wait 300                                        # the window's 100 ms timer shows the new list
cl_assert_line 2 error
shot docs/screenshots/w3/cuelist-mp-play.png
cl_execute
wait 1000
assert_view cue_number 2                         # line 1 cue 0001, line 2 skipped, line 3 cue 0002 after 0.50 s
cl_assert_line 2 error
cl_assert_line 3 done

# ---- 12 Q9: the two cue list prompts (exe 0x188D9C / 0x17FD7C, 0x17DF50) ----
log "W3 acceptance: cue list prompts"
cl_goto 1
click TCuelist2Form.AdvanceManual1               # a change: CueList Modified
click TCuelist2Form.sbNew
assert_prompt "Current CueList was modified"
assert_prompt "This will clear the current cuelist"
shot docs/screenshots/w3/cuelist-new-prompt.png
click TConfirmForm.BCancel
cl_assert_line 2 error                           # Cancel kept the list
cl_load tests/ui/scripts/w3_link.Cl2             # line 2 = Link Cuelist 0001 ("twenty")
wait 300
cl_goto 1
click TCuelist2Form.AdvanceManual1
cl_execute                                       # Go on an idle list = Run from top
assert_prompt "Modified cuelist includes link to other cuelist - run without saving first ?"
shot docs/screenshots/w3/cuelist-link-prompt.png
click TConfirmForm.BCancel
cl_assert_line 1 plain                           # Cancel: not run

# ---- acceptance 3 (live half): a generic macro, Sine at amplitude 186, on the MAC 500 ----
log "W3 acceptance: generic macro amplitude 186"
click main.icon1
open genmacro_editor
click TCueMacroControlForm.sbSelectAll                # the master's channels in pChannels
dblclick TCueMacroControlForm.lvBuiltIn 40 107        # row 7 'Sine' (14 sA.6 order): y = border 2 + 7 x 14 + 7; click takes no .row.col
assert_text TCueMacroControlForm.lMacro "Sine"
click TCueMacroControlForm.cbSym                      # Keep Amplitude Symmetrical
click TCueMacroControlForm.pbAmpPos 126 6             # x 126 of the 147-px -255..255 bar = 126 * 510 / 146 - 255 = 185
click TCueMacroControlForm.sbPosAmpInc               # + 1 = 186 (no bar x gives 186 exactly)
assert_text TCueMacroControlForm.lMinMax "Min/Max : -186/186"  # LJ_GENMACRO_AMP186_EXAMPLE, EXE 0x3399F8 "Min/Max : %d/%d"
assert_view gm_engine_on=1 gm_slot_on=1
shot docs/screenshots/w3/genmacro-amp186.png
click TCueMacroControlForm.sbDisableMacros          # off again: rank 6 would move the MAC 500's pan / tilt under the movement macro below
wait 200
assert_view gm_engine_on=0
close genmacro_editor

# ---- acceptance 4 (live half): a movement macro, System Ellipse, frozen at index 0, at two ticks ----
# pan = home 0 + round(32767 * 100 * 32768 / (127 * 32767)) = 25802, tilt = sin 0 = 0 (17-position_ref.py macro_offset)
log "W3 acceptance: movement macro"
click main.tb_fixture_13                         # None
click main.icon1
click main.tb_fixture_9                          # Home: pan / tilt 50 % = readout 0
mm_set 1 1 100 0                                 # System Ellipse, amplitude 100, speed 0 = frozen [03 s5.11]
wait 200
assert_pos 1 25802 0
wait 500
assert_pos 1 25802 0
mm_set 1 1 100 50                                # running: the trace window
open movemacro_editor
wait 500
shot docs/screenshots/w3/movemacro-ellipse.png
close movemacro_editor
mm_set 1 0 0 0

# ---- Fan Out over the five MAC 500s ----
log "W3 acceptance: Fan Out"
click main.tb_fixture_13
click main.icon1
click main.icon3
click main.icon4
click main.icon5
click main.icon6
click main.tb_fixture_9                          # home all five
open fan_out
rclick TFanOutForm.DeltaPan 219 5                # right-click on the bar's right arrow = max 127: Delta Pan 127 x 256 = 32512
wait 300
assert_pos 1 -32512 0                            # 17 s5.2: round(32512 * (i - m) / m), m = 2, about the middle fixture (homed: 0)
assert_pos 3 -16256 0
assert_pos 4 0 0
assert_pos 5 16256 0
assert_pos 6 32512 0
shot docs/screenshots/w3/fan-out.png
close fan_out

# ---- acceptance 5-7 (UI half): a synthetic .Udf imports; the profile editor's Q9 prompt ----
# w3_synthetic.Udf was written by our lj_udf_export from the built-in Generic DMX Dimmer (no Martin bytes);
# gs2_import fails unless Reload profile data lists the profile afterwards.
log "W3 acceptance: .Udf import, profile editor"
gs2_import tests/ui/scripts/w3_synthetic.Udf
assert_file UserFixtureDef/w3_synthetic.GS2 exists
open profile_editor                              # a New Profile record (no fixture selected)
click TScanner2DefsForm.eAuthor
type "W3"
click TScanner2DefsForm.bCancel
assert_prompt "Any unapplied profile changes will be lost ?"   # 12 Q9 (exe 0x319674)
shot docs/screenshots/w3/profile-editor-prompt.png
click TConfirmForm.BCancel
close profile_editor

shot docs/screenshots/w3/end.png
quit
