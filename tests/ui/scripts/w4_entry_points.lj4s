assert_caption save_lightcorder "Save Lightcorder File"
log "PASS Save Lightcorder File (TSaveLightCorderFileDialog) <- Record to LightCorder file > Cancel Recording"
dump_captions caption_dump_entry.tsv
shot docs/screenshots/w4/entry/save-lightcorder.png
