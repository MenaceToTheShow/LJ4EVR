# W5 acceptance row 4, part 2: live sACN input from a loopback sender, after part 1 saved the DMX-in configuration.
# Started together with `python -I tools/ref/w5_wire.py send sacn 10 0:2=200,3=100,14=255 6000:3=200 12000:stop`
# (127.0.0.2 -> 127.0.0.1:5568, 40 packets/s). Checks at about 4 s, 9.5 s and 16.5 s of sender time.
wait 1500
click main.tb_cuelist_10
wait 1500
assert_text TDmxInForm.lChIn "DMX Channels In 512"
assert_frame 1:1=200
assert_frame 1:3=0
shot ../w5shots/dmxin-live.png
wait 5500
assert_frame 1:1=200
assert_frame 1:3=255
shot ../w5shots/dmxin-live-table.png
# the sender stops at 12 s: after 2.5 s without a packet the source is lost and the frame holds (Loss=0, the default)
wait 7000
assert_text TDmxInForm.lFreq "Update Freq 0 Hz"
assert_frame 1:1=200
assert_frame 1:3=255
shot ../w5shots/dmxin-lost.png
quit
